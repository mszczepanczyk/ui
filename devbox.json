{
	"$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",
	"packages": [
		"alsa-lib.out",
		"at-spi2-atk.out",
		"at-spi2-core.out",
		"atk.out",
		"cairo.out",
		"cups.lib",
		"dbus.lib",
		"expat.out",
		"fontconfig.lib",
		"freetype.out",
		"gcc-unwrapped.lib",
		"gdk-pixbuf.out",
		"glib.out",
		"gtk3.out",
		"libgbm.out",
		"libx11.out",
		"libxcb.out",
		"libxcomposite.out",
		"libxcursor.out",
		"libxdamage.out",
		"libxext.out",
		"libxfixes.out",
		"libxi.out",
		"libxkbcommon.out",
		"libxrandr.out",
		"libxrender.out",
		"nspr.out",
		"nss.out",
		"pango.out",
		"udev.out"
	],
	"env": {
		// Playwright's npm-downloaded browser binaries are unpatched dynamic
		// executables that expect shared libs (glib, nss, atk, ...) at standard
		// FHS paths, which Nix doesn't use, so point them at the devbox profile.
		"LD_LIBRARY_PATH": "$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib:$LD_LIBRARY_PATH",
		"DEVBOX_COREPACK_ENABLED": "true"
	},
	"shell": {
		"scripts": {
			"install": [
				"npm install",
				"npm run examples:install",
				"npx playwright install chromium"
			],
			"build": ["npm run build", "npm run examples:build"],
			"test": ["npm run typecheck", "npm run lint", "npm run test:visual"]
		}
	}
}
